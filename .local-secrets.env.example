# =============================================================================
# .local-secrets.env  (gitignored — copy to .local-secrets.env and fill)
# =============================================================================
# Credentials for driving the Coolify API (env updates + redeploy) and the
# cutter service secrets. Never committed, never printed to chat.
# Used by scripts/coolify-*.sh (same pattern as domovina-api).
# =============================================================================

# --- Coolify API ---
# Token: https://app.domovina.link/security/api-tokens (Read + Write).
# ⚠️ Coolify tokens contain a `|` character — ALWAYS quote it ("..."), otherwise
#    the shell treats it as a pipe and sourcing the file breaks.
COOLIFY_API_URL=https://app.domovina.link
COOLIFY_API_TOKEN=""
# Application UUID — from the Coolify app URL (.../application/<UUID>/...).
COOLIFY_APP_UUID=xlvkm0tcfeky6tc8eubnbl85

# --- cutter service secrets ---
# Bearer token the Cloudflare Worker sends on POST /cut. MUST match the Worker
# secret (wrangler secret put CUTTER_API_KEY). Generate: openssl rand -hex 32
CUTTER_API_KEY=""

# Path to the source .env holding the R2 S3 credentials (R2_ACCOUNT_ID,
# R2_ACCESS_KEY_ID, R2_SECRET_ACCESS_KEY). Default points at the main repo.
# coolify-sync-secrets.sh reads them from here and pushes to Coolify — the
# values never land in this repo.
R2_SOURCE_ENV=../fetch.domovina.tv/.env
