# Coolify env for the domovina-cutter service. Copy to the Coolify app's
# environment (never commit real values).

# R2 S3 credentials — scoped Object Read & Write token for bucket cdn-domovina-ai.
# Same type/token family as the main fetch.domovina.tv repo .env.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=cdn-domovina-ai

# Shared bearer token the Cloudflare Worker sends on POST /cut.
# Generate: openssl rand -hex 32
CUTTER_API_KEY=

# Listen port (Coolify maps the domain to this).
PORT=8080
