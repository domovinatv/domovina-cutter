{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "domovina-cutter",
  "main": "src/index.ts",
  "account_id": "7dc7167b7e2e00923bfa7cd697df14e4",
  "compatibility_date": "2026-07-01",
  "observability": {
    "enabled": true
  },
  // Public custom domain. wrangler provisions the DNS record + cert in the
  // domovina.ai zone. The cutter service lives on a different subdomain.
  "routes": [
    {
      "pattern": "cutter.domovina.ai",
      "custom_domain": true
    }
  ],
  // R2 bucket that also backs cdn.domovina.ai. Clips live under the clips/
  // prefix. Worker uses this binding ONLY (no S3 keys) for head/get/302.
  "r2_buckets": [
    {
      "binding": "CLIPS",
      "bucket_name": "cdn-domovina-ai"
    }
  ],
  "vars": {
    // Base URL of the Coolify-hosted ffmpeg cutter microservice.
    // Update to the real subdomain once the Coolify app is deployed.
    "CUTTER_URL": "https://cutter-svc.domovina.ai"
  },
  // A prior deploy registered CutterContainer + SingleFlight Durable Objects
  // before the (now removed) CF Container path was abandoned. v2 deletes them.
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["CutterContainer", "SingleFlight"]
    },
    {
      "tag": "v2",
      "deleted_classes": ["CutterContainer", "SingleFlight"]
    }
  ]
  // Secret (wrangler secret put): CUTTER_API_KEY — bearer token for the service.
  // Custom domain cutter.domovina.ai is added at deploy time (see README).
}
